# Public Google OAuth web client ID only. Never put a client secret here.
VITE_GOOGLE_CLIENT_ID=

# Optional shared Firebase Spark project (public Web app config; never Admin keys).
# Enable Google Auth and publish firestore.rules before enabling for customers.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
